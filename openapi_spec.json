{
  "openapi": "3.1.0",
  "info": {
    "title": "Salazar-Corcoran Creatinine Clearance API",
    "description": "Reference CrCl estimation plus separate demonstration-only audit endpoints. No authentication or clinical certification.",
    "version": "3.0.0"
  },
  "paths": {
    "/api/crcl": {
      "post": {
        "summary": "Calculate estimated creatinine clearance (mL/min)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "sex",
                  "age_years",
                  "weight_kg",
                  "height_m",
                  "serum_creatinine_mg_dl"
                ],
                "properties": {
                  "sex": {
                    "type": "string",
                    "enum": [
                      "male",
                      "female"
                    ]
                  },
                  "age_years": {
                    "type": "number",
                    "description": "Adult age in years"
                  },
                  "weight_kg": {
                    "type": "number",
                    "description": "Actual weight in kg"
                  },
                  "height_m": {
                    "type": "number",
                    "description": "Height in metres"
                  },
                  "serum_creatinine_mg_dl": {
                    "type": "number",
                    "description": "Serum creatinine in mg/dL"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Salazar-Corcoran CrCl estimate in mL/min"
          },
          "422": {
            "description": "Missing or invalid input"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health metadata",
        "responses": {
          "200": {
            "description": "JSON metadata"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON counters, not Prometheus exposition format",
        "responses": {
          "200": {
            "description": "JSON counters"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Demonstration-only generic audit processing",
        "responses": {
          "200": {
            "description": "Prototype dossier"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Mock response only, not model inference",
        "responses": {
          "200": {
            "description": "Non-clinical mocked message"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Audit block count and integrity status only",
        "responses": {
          "200": {
            "description": "Counts and boolean HMAC integrity check"
          }
        }
      }
    }
  }
}
